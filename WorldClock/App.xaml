<Application x:Class="WorldClock.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Color Palette -->
        <Color x:Key="BackgroundDark">#0D0D1A</Color>
        <Color x:Key="BackgroundMid">#12122A</Color>
        <Color x:Key="BackgroundCard">#1A1A35</Color>
        <Color x:Key="AccentCyan">#00E5FF</Color>
        <Color x:Key="AccentBlue">#1565C0</Color>
        <Color x:Key="AccentGold">#FFD600</Color>
        <Color x:Key="AccentGreen">#00E676</Color>
        <Color x:Key="AccentPurple">#CE93D8</Color>
        <Color x:Key="AccentOrange">#FF9100</Color>
        <Color x:Key="AccentPink">#FF4081</Color>
        <Color x:Key="TextDim">#607D8B</Color>

        <SolidColorBrush x:Key="BrushBackgroundDark" Color="{StaticResource BackgroundDark}"/>
        <SolidColorBrush x:Key="BrushBackgroundMid"  Color="{StaticResource BackgroundMid}"/>
        <SolidColorBrush x:Key="BrushBackgroundCard" Color="{StaticResource BackgroundCard}"/>
        <SolidColorBrush x:Key="BrushAccentCyan"     Color="{StaticResource AccentCyan}"/>
        <SolidColorBrush x:Key="BrushAccentGold"     Color="{StaticResource AccentGold}"/>
        <SolidColorBrush x:Key="BrushAccentGreen"    Color="{StaticResource AccentGreen}"/>
        <SolidColorBrush x:Key="BrushAccentPurple"   Color="{StaticResource AccentPurple}"/>
        <SolidColorBrush x:Key="BrushAccentOrange"   Color="{StaticResource AccentOrange}"/>
        <SolidColorBrush x:Key="BrushAccentPink"     Color="{StaticResource AccentPink}"/>
        <SolidColorBrush x:Key="BrushTextDim"        Color="{StaticResource TextDim}"/>
        <SolidColorBrush x:Key="BrushTextPrimary"    Color="White"/>
        <SolidColorBrush x:Key="BrushSeparator"      Color="#2A2A4A"/>
        <SolidColorBrush x:Key="BrushWhite"          Color="White"/>
        <!-- Transparent overlay for the window — alpha channel is changed at runtime for the acrylic effect -->
        <SolidColorBrush x:Key="BrushWindowChrome"   Color="#CC0D0D1A"/>

        <!-- Glow opacity defaults (0.0 = off for light, fractional for dark) -->
        <!-- ThemeService.Apply() overwrites these at runtime -->
        <sys:Double x:Key="GlowOpacity">0.7</sys:Double>
        <sys:Double x:Key="GlowOpacitySubtle">0.35</sys:Double>
        <!-- White stroke glow for emoji icons (country flag, UTC globe, world clock globe) -->
        <!-- 0.9 on dark themes, 0.0 on light themes — set by ThemeService.Apply() -->
        <sys:Double x:Key="IconGlowOpacity">0.9</sys:Double>
        <sys:Double x:Key="CardShadowOpacity">0.55</sys:Double>

        <!-- DST active badge color: bright yellow (dark) / readable amber (light) -->
        <!-- ThemeService.Apply() overwrites at runtime -->
        <SolidColorBrush x:Key="BrushDstActive" Color="#FFD600"/>

        <!-- UTC banner gradient: dark navy (dark themes) / surface variant (light themes) -->
        <!-- ThemeService.Apply() overwrites at runtime -->
        <Color x:Key="BannerGradientStart">#BB0A1628</Color>
        <Color x:Key="BannerGradientEnd">#BB003366</Color>

        <!-- Card Style — DynamicResource so it reacts to theme changes -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background"       Value="{DynamicResource BrushBackgroundCard}"/>
            <Setter Property="CornerRadius"     Value="12"/>
            <Setter Property="Padding"          Value="20,16"/>
            <Setter Property="Margin"           Value="8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="4"
                                      Opacity="{DynamicResource CardShadowOpacity}"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── ComboBoxItem: theme-aware item rows in every dropdown ────────── -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource BrushBackgroundMid}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="Padding"    Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource BrushAccentCyan}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource BrushBackgroundDark}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── ComboBox: theme-aware selection box + popup background ───────── -->
        <Style TargetType="ComboBox">
            <Setter Property="Background"             Value="{DynamicResource BrushBackgroundMid}"/>
            <Setter Property="Foreground"             Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderBrush"            Value="{DynamicResource BrushSeparator}"/>
            <Setter Property="BorderThickness"        Value="1"/>
            <Setter Property="Padding"                Value="8,6"/>
            <Setter Property="MinHeight"              Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility"   Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="24"/>
                            </Grid.ColumnDefinitions>
                            <!-- Selection area border -->
                            <Border x:Name="BdMain"
                                    Grid.ColumnSpan="2"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"/>
                            <!-- Selected item display -->
                            <ContentPresenter x:Name="ContentSite"
                                              Grid.Column="0"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                            <!-- Editable text box (IsEditable=True) -->
                            <TextBox x:Name="PART_EditableTextBox"
                                     Grid.Column="0"
                                     Style="{x:Null}"
                                     Background="Transparent"
                                     Foreground="{TemplateBinding Foreground}"
                                     CaretBrush="{DynamicResource BrushAccentCyan}"
                                     Padding="{TemplateBinding Padding}"
                                     VerticalAlignment="Center"
                                     Visibility="Hidden"
                                     IsReadOnly="{TemplateBinding IsReadOnly}"/>
                            <!-- Arrow button -->
                            <ToggleButton Grid.Column="1"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                              RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Cursor="Hand">
                                <Path Data="M 0 0 L 5 5 L 10 0"
                                      Stroke="{DynamicResource BrushTextDim}"
                                      StrokeThickness="1.5"
                                      Width="10" Height="5"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      SnapsToDevicePixels="True"/>
                            </ToggleButton>
                            <!-- Dropdown popup -->
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder"
                                        MinWidth="{Binding ActualWidth,
                                            RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{DynamicResource BrushBackgroundMid}"
                                        BorderBrush="{DynamicResource BrushSeparator}"
                                        BorderThickness="1"
                                        CornerRadius="0,0,4,4">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentSite"          Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="BdMain" Property="CornerRadius"
                                        Value="4,4,0,0"/>
                                <Setter TargetName="BdMain" Property="BorderBrush"
                                        Value="{DynamicResource BrushAccentCyan}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BdMain" Property="BorderBrush"
                                        Value="{DynamicResource BrushAccentCyan}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>

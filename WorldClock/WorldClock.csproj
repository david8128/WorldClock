<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe suppresses the CMD console window on Windows; treated as Exe on Linux -->
    <OutputType Condition="$([MSBuild]::IsOSPlatform('Windows'))">WinExe</OutputType>
    <OutputType Condition="!$([MSBuild]::IsOSPlatform('Windows'))">Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AssemblyName>WorldClock</AssemblyName>
    <RootNamespace>WorldClock</RootNamespace>
    <ApplicationIcon>Images/Logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Images/Logo.ico"/>
    <AvaloniaResource Include="Images/Logo.png"/>
    <AvaloniaResource Include="Assets/Fonts/NotoColorEmoji.ttf"/>
  </ItemGroup>

  <!--
    Workaround for Avalonia 11.2.3 + .NET 10 Windows build issue:
    AvaloniaBuildTasks.props adds "**\*.axaml" as AvaloniaXaml in a static
    ItemGroup, but on Windows the glob reaches GenerateAvaloniaResourcesTask
    as a literal path ("…\WorldClock\**\*.axaml"), causing an IOException.
    Solution: wipe the auto-glob items and enumerate the files explicitly.
  -->
  <ItemGroup>
    <AvaloniaXaml Remove="@(AvaloniaXaml)" />
    <AvaloniaXaml Include="App.axaml"              SubType="Designer" />
    <AvaloniaXaml Include="MainWindow.axaml"       SubType="Designer" />
    <AvaloniaXaml Include="SettingsWindow.axaml"   SubType="Designer" />
    <AvaloniaXaml Include="DiagnosticsWindow.axaml" SubType="Designer" />
    <AvaloniaXaml Include="Styles.axaml"           SubType="Designer" />
  </ItemGroup>

  <!-- Exclude Python virtual environment -->
  <ItemGroup>
    <Compile Remove="citiesdb\**"/>
    <None Remove="citiesdb\**"/>
    <EmbeddedResource Remove="citiesdb\**"/>
    <Content Remove="citiesdb\**"/>
  </ItemGroup>

  <!-- Exclude old WPF .xaml files — replaced by .axaml equivalents -->
  <ItemGroup>
    <Compile Remove="App.xaml.cs"/>
    <None Include="App.xaml"/>
    <AvaloniaResource Remove="App.xaml"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <!-- Override vulnerable transitive dependency (CVE-2026-39959 / GHSA-xrw6-gwf8-vvr9) -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Allow the test project to access internal members -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>WorldClock.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>

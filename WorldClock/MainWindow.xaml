<Window x:Class="WorldClock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WorldClock"
        xmlns:helpers="clr-namespace:WorldClock.Helpers"
        xmlns:vm="clr-namespace:WorldClock.ViewModels"
        mc:Ignorable="d"
        Title="World Clock" Icon="Images/Logo.ico" Height="760" Width="1100"
        MinHeight="300" MinWidth="430"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        FontFamily="Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome x:Name="AppWindowChrome"
                      CaptionHeight="72"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:SlotIndexToCanvasLeftConverter x:Key="SlotToPx"/>
        <helpers:HexStringToBrushConverter x:Key="HexToBrush"/>

        <Style x:Key="DigitalTime" TargetType="TextBlock">
            <Setter Property="FontFamily"    Value="Consolas"/>
            <Setter Property="FontSize"      Value="46"/>
            <Setter Property="FontWeight"    Value="Bold"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CityLabel" TargetType="TextBlock">
            <Setter Property="FontSize"      Value="18"/>
            <Setter Property="FontWeight"    Value="SemiBold"/>
            <Setter Property="Foreground"    Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SubLabel" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="11"/>
            <Setter Property="Foreground"   Value="{DynamicResource BrushTextDim}"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <!-- Frameless window control buttons -->
        <Style x:Key="WinCtrlBtn" TargetType="Button">
            <Setter Property="Width"           Value="46"/>
            <Setter Property="Height"          Value="36"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground"      Value="{DynamicResource BrushTextDim}"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WinCloseBtn" TargetType="Button" BasedOn="{StaticResource WinCtrlBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C00C0C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact TextBox for inline card editing -->
        <Style x:Key="CardEditBox" TargetType="TextBox">
            <Setter Property="Padding"                  Value="6,4"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="BorderBrush"              Value="{DynamicResource BrushSeparator}"/>
            <Setter Property="Background"               Value="{DynamicResource BrushBackgroundDark}"/>
            <Setter Property="Foreground"               Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="FontSize"                 Value="12"/>
            <Setter Property="CaretBrush"               Value="{DynamicResource BrushAccentCyan}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource BrushAccentCyan}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Responsive root: Viewbox.Stretch="Uniform" scales the fixed 1100×760 design
         proportionally to fill any window size (ProportionScale default).
         MinLimit mode keeps minimum pixel dimensions and shows scrollbars below them.
         ApplyScaleMode() in code-behind switches between the two modes. -->
    <ScrollViewer x:Name="ScaleScrollViewer"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Disabled"
                  Background="{DynamicResource BrushBackgroundDark}">
        <!-- Stretch="Uniform" scales the 1100×760 design to fit any window size -->
        <Viewbox x:Name="ScaleViewbox" Stretch="Uniform">
            <Grid x:Name="DesignRoot"
                  Width="1100" Height="760">

    <!-- Root: semi-transparent so the acrylic blur shows through when opacity < 1 -->
    <Border Background="{DynamicResource BrushBackgroundDark}">
        <Grid x:Name="LayoutRoot">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- 0: header -->
                <RowDefinition Height="Auto"/>  <!-- 1: UTC banner -->
                <RowDefinition Height="*"/>     <!-- 2: main content (left clocks + right translator) -->
                <RowDefinition Height="Auto"/>  <!-- 3: footer -->
            </Grid.RowDefinitions>

            <!-- HEADER / TITLE BAR -->
            <Border Grid.Row="0"
                    Background="{DynamicResource BrushBackgroundMid}"
                    Padding="24,10,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🌍" FontSize="28" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="White" BlurRadius="24" ShadowDepth="0"
                                                  Opacity="{DynamicResource GlowOpacitySubtle}"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="WORLD CLOCK"
                                       FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource BrushAccentCyan}"
                                       FontFamily="Consolas"/>
                            <TextBlock Text="Global Team Time Tracker"
                                       FontSize="11"
                                       Foreground="{DynamicResource BrushTextDim}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Stretch" HorizontalAlignment="Right">
                        <TextBlock x:Name="HeaderDate"
                                   FontSize="12" Foreground="{DynamicResource BrushTextPrimary}"
                                   FontFamily="Consolas"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                        <Button x:Name="SettingsButton"
                                Content="⚙" FontSize="18"
                                Width="40" Height="40"
                                Background="Transparent" BorderThickness="0"
                                Foreground="{DynamicResource BrushAccentCyan}"
                                Cursor="Hand" ToolTip="Open Settings"
                                AutomationProperties.Name="SettingsButton"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="SettingsButton_Click"/>
                        <Rectangle Width="1" Fill="{DynamicResource BrushSeparator}"
                                   Margin="6,8" VerticalAlignment="Stretch"/>
                        <Button Content="─" Style="{StaticResource WinCtrlBtn}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="MinimizeWindow_Click" ToolTip="Minimize"/>
                        <Button x:Name="MaximizeButton" Content="□"
                                Style="{StaticResource WinCtrlBtn}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="MaximizeWindow_Click" ToolTip="Maximize"/>
                        <Button Content="✕" Style="{StaticResource WinCloseBtn}"
                                Foreground="White"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="CloseWindow_Click" ToolTip="Close"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- UTC BANNER -->
            <Border Grid.Row="1" Margin="16,10,16,0" CornerRadius="12" Padding="24,16">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{DynamicResource BannerGradientStart}" Offset="0"/>
                        <GradientStop Color="{DynamicResource BannerGradientEnd}" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect Color="#00E5FF" BlurRadius="20" ShadowDepth="0"
                                      Opacity="{DynamicResource GlowOpacitySubtle}"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Text="🌐" FontSize="34" HorizontalAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="White" BlurRadius="24" ShadowDepth="0"
                                                  Opacity="{DynamicResource GlowOpacitySubtle}"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="Universal Time" FontSize="13"
                                   Foreground="{DynamicResource BrushTextDim}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="UtcTime"
                                   Style="{StaticResource DigitalTime}" FontSize="58"
                                   Foreground="{DynamicResource BrushAccentCyan}">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#00E5FF" BlurRadius="24" ShadowDepth="0"
                                                  Opacity="{DynamicResource GlowOpacity}"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock x:Name="UtcDate" FontSize="17" FontFamily="Consolas"
                                   Foreground="{DynamicResource BrushTextDim}" TextAlignment="Center" Margin="0,2,0,0"/>
                        <TextBlock Text="— STD" FontFamily="Consolas" FontSize="13"
                                   Foreground="{DynamicResource BrushTextDim}"
                                   TextAlignment="Center" Margin="0,2,0,0"
                                   ToolTip="UTC has no daylight saving time"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="20,0,0,0">
                        <TextBlock Text="UTC+00:00" FontFamily="Consolas" FontSize="17"
                                   Foreground="{DynamicResource BrushAccentCyan}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Coordinated" FontSize="12"
                                   Foreground="{DynamicResource BrushTextDim}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Universal Time" FontSize="12"
                                   Foreground="{DynamicResource BrushTextDim}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- MAIN CONTENT: left vertical clocks sidebar + right time visualizer -->
            <Grid x:Name="MainContentGrid" Grid.Row="2" Margin="16,10,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ClocksColumnDef" Width="220"/>  <!-- left: compact vertical clocks panel -->
                    <ColumnDefinition x:Name="VisualizerColumnDef" Width="*"/>    <!-- right: time visualizer -->
                </Grid.ColumnDefinitions>

                <!-- ══════════════════════════════════════════════════════
                     LEFT PANEL — compact vertical clock list
                     Replaces the old horizontal bottom cards (WrapPanel).
                     Each row: accent bar | drag | flag | city + time + offset
                     ══════════════════════════════════════════════════════ -->
                <Border x:Name="ClocksPanelBorder" Grid.Column="0"
                        Background="{DynamicResource BrushBackgroundMid}"
                        CornerRadius="10,0,0,10" Margin="0,0,2,0">
                    <DockPanel>
                        <!-- Panel header -->
                        <Border x:Name="ClocksPanelHeader" DockPanel.Dock="Top"
                                Background="{DynamicResource BrushBackgroundCard}"
                                CornerRadius="10,0,0,0" Padding="12,8">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🕐" FontSize="13" Margin="0,0,6,0"
                                               VerticalAlignment="Center">
                                        <TextBlock.Effect>
                                            <DropShadowEffect Color="White" BlurRadius="16"
                                                              ShadowDepth="0"
                                                              Opacity="{DynamicResource GlowOpacitySubtle}"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                    <TextBlock Text="CLOCKS"
                                               FontFamily="Consolas" FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource BrushAccentCyan}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <!-- Right-side mini-settings: Edit + Delete toggles + re-open button -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <!-- Edit mode toggle (✏) -->
                                    <Border x:Name="EditModeBtnBorder" CornerRadius="5"
                                            Width="22" Height="22" Cursor="Hand"
                                            ToolTip="Toggle edit mode"
                                            MouseLeftButtonUp="ToggleEditMode_Click">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#33FFFFFF"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="✏" FontSize="11"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource BrushTextDim}"/>
                                    </Border>
                                    <!-- Delete mode toggle (🗑) -->
                                    <Border x:Name="DeleteModeBtnBorder" CornerRadius="5"
                                            Width="22" Height="22" Cursor="Hand" Margin="2,0,0,0"
                                            ToolTip="Toggle delete mode"
                                            MouseLeftButtonUp="ToggleDeleteMode_Click">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#33FFFFFF"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="🗑" FontSize="11"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource BrushTextDim}"/>
                                    </Border>
                                    <!-- Re-open Time Visualizer (only when visualizer is collapsed) -->
                                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            Foreground="{DynamicResource BrushAccentCyan}"
                                            ToolTip="Open Time Visualizer" Margin="4,0,0,0"
                                            Click="ToggleTranslator_Click">
                                        <TextBlock FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                                                   Text="⏱ ▶ VISUALIZER"/>
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bd" Background="Transparent"
                                                                    CornerRadius="4" Padding="6,2">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Translator.IsOpen}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border DockPanel.Dock="Top" Height="1"
                                Background="{DynamicResource BrushSeparator}"/>
                        <!-- Auto-scaling clock list: Viewbox Uniform scales all cards
                             proportionally so text never distorts. The window-grow mechanism
                             (UpdateWindowSizeForClocks) ensures the available height grows
                             when many clocks are added, so cards stay at natural size. -->
                        <Viewbox Stretch="Uniform" VerticalAlignment="Top" HorizontalAlignment="Stretch">
                            <ItemsControl x:Name="LocationsPanel" ItemsSource="{Binding Locations}"
                                          Width="220">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border AllowDrop="True"
                                                Margin="0,0,0,1"
                                                Background="{DynamicResource BrushBackgroundMid}"
                                                DragOver="Card_DragOver"
                                                DragLeave="Card_DragLeave"
                                                Drop="Card_Drop">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource BrushBackgroundCard}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid MinHeight="72">
                                                <!-- Left accent bar -->
                                                <Border HorizontalAlignment="Left" Width="4"
                                                        CornerRadius="2" Margin="0,4,0,4"
                                                        Background="{Binding ThemedAccentBrush}"/>

                                                <!-- NORMAL VIEW -->
                                                <Grid Margin="10,6,6,6">
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>  <!-- drag handle -->
                                                        <ColumnDefinition Width="Auto"/>  <!-- flag -->
                                                        <ColumnDefinition Width="*"/>     <!-- city + time + offset -->
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Drag handle -->
                                                    <TextBlock Grid.Column="0" Text="⠇" FontSize="13"
                                                               Foreground="{DynamicResource BrushTextDim}"
                                                               VerticalAlignment="Center" Margin="0,0,4,0"
                                                               Cursor="SizeAll" ToolTip="Drag to reorder"
                                                               PreviewMouseLeftButtonDown="DragHandle_MouseDown"/>
                                                    <!-- Flag -->
                                                    <TextBlock Grid.Column="1" Text="{Binding CountryFlag}"
                                                               FontSize="28" VerticalAlignment="Center"
                                                               Margin="0,0,6,0">
                                                        <TextBlock.Effect>
                                                            <DropShadowEffect Color="White" BlurRadius="16"
                                                                              ShadowDepth="0"
                                                                              Opacity="{DynamicResource GlowOpacitySubtle}"/>
                                                        </TextBlock.Effect>
                                                    </TextBlock>
                                                    <!-- City, time, offset -->
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <!-- City name + HOME badge -->
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding CityName}"
                                                                       FontSize="17" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource BrushTextPrimary}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center"/>
                                                            <Border CornerRadius="3" Padding="3,0" Margin="4,0,0,0"
                                                                    Background="{DynamicResource BrushAccentCyan}">
                                                                <TextBlock Text="HOME" FontFamily="Consolas" FontSize="7"
                                                                           FontWeight="Bold" Foreground="#0D1117"
                                                                           VerticalAlignment="Center"/>
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsHome}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding TeamLabel}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource BrushTextDim}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,0,0,1">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding TeamLabel}" Value="">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding CurrentTime}"
                                                                   FontFamily="Consolas" FontSize="23"
                                                                   FontWeight="Bold"
                                                                   Foreground="{Binding ThemedAccentBrush}">
                                                            <TextBlock.Effect>
                                                                <DropShadowEffect BlurRadius="8" ShadowDepth="0"
                                                                                  Opacity="{DynamicResource GlowOpacity}"
                                                                                  Color="#00BFFF"/>
                                                            </TextBlock.Effect>
                                                        </TextBlock>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding UtcOffset}"
                                                                       FontFamily="Consolas" FontSize="13"
                                                                       Foreground="{Binding ThemedAccentBrush}"/>
                                                            <Border CornerRadius="2" Padding="3,1" Margin="4,0,0,0"
                                                                    Background="{DynamicResource BrushBackgroundDark}">
                                                                <TextBlock Text="{Binding DstLabel}"
                                                                           FontFamily="Consolas" FontSize="12"
                                                                           FontWeight="Bold">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{DynamicResource BrushTextDim}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsDst}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource BrushDstActive}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>
                                                            <!-- Diff-from-home badge -->
                                                            <Border CornerRadius="2" Padding="3,1" Margin="4,0,0,0"
                                                                    Background="#22FFFFFF">
                                                                <TextBlock Text="{Binding DiffFromHome}"
                                                                           FontFamily="Consolas" FontSize="12"
                                                                           FontWeight="Bold"
                                                                           Foreground="{DynamicResource BrushTextDim}"/>
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasDiffFromHome}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                            </Border>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- EDIT VIEW -->
                                                <Grid Margin="10,6,6,6">
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <StackPanel>
                                                        <TextBlock Text="✏ EDIT"
                                                                   FontFamily="Consolas" FontSize="8" FontWeight="Bold"
                                                                   Foreground="{DynamicResource BrushAccentCyan}"
                                                                   Margin="0,0,0,4"/>
                                                        <Grid Margin="0,0,0,3">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="28"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox Grid.Column="0"
                                                                     Text="{Binding EditingCountryFlag, UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource CardEditBox}"
                                                                     FontSize="13" Padding="2"
                                                                     Margin="0,0,2,0" ToolTip="Flag emoji"/>
                                                            <TextBox Grid.Column="1"
                                                                     Text="{Binding EditingCityName, UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource CardEditBox}"
                                                                     FontSize="10" ToolTip="City name"/>
                                                        </Grid>
                                                        <TextBox Text="{Binding EditingTeamLabel, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource CardEditBox}"
                                                                 FontSize="10" Margin="0,0,0,4"
                                                                 ToolTip="Team label"/>
                                                        <!-- Accent colour swatches -->
                                                        <TextBlock Text="Accent colour" FontFamily="Consolas" FontSize="8"
                                                                   Foreground="{DynamicResource BrushTextDim}" Margin="0,0,0,2"/>
                                                        <ListBox SelectedValue="{Binding EditingAccentHex, Mode=TwoWay}"
                                                                 SelectedValuePath="Hex"
                                                                 ItemsSource="{Binding DataContext.ThemedAccentPalette, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                 Background="Transparent" BorderThickness="0"
                                                                 Margin="0,0,0,4" Padding="0"
                                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                            <ListBox.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel/>
                                                                </ItemsPanelTemplate>
                                                            </ListBox.ItemsPanel>
                                                            <ListBox.ItemContainerStyle>
                                                                <Style TargetType="ListBoxItem">
                                                                    <Setter Property="Padding" Value="0"/>
                                                                    <Setter Property="Margin" Value="2"/>
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                                <Border x:Name="Ring" Width="18" Height="18" CornerRadius="9"
                                                                                        BorderThickness="2" BorderBrush="Transparent" Cursor="Hand">
                                                                                    <Ellipse Width="12" Height="12"
                                                                                             Fill="{Binding Display}"/>
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsSelected" Value="True">
                                                                                        <Setter TargetName="Ring" Property="BorderBrush" Value="White"/>
                                                                                    </Trigger>
                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                        <Setter TargetName="Ring" Property="BorderBrush" Value="#66FFFFFF"/>
                                                                                    </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </Style>
                                                            </ListBox.ItemContainerStyle>
                                                        </ListBox>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <Button Content="✓" Click="SaveCard_Click" Tag="{Binding}"
                                                                    Background="#1B5E20" Foreground="White"
                                                                    Width="28" Height="20" FontSize="11"
                                                                    BorderThickness="0" Cursor="Hand"
                                                                    Margin="0,0,4,0">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="{TemplateBinding Background}"
                                                                                CornerRadius="4" Padding="2">
                                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                                              VerticalAlignment="Center"/>
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>
                                                            <Button Content="✕" Click="CancelCard_Click" Tag="{Binding}"
                                                                    Background="#7F2020" Foreground="White"
                                                                    Width="20" Height="20" FontSize="10"
                                                                    BorderThickness="0" Cursor="Hand">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="{TemplateBinding Background}"
                                                                                CornerRadius="4" Padding="2">
                                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                                              VerticalAlignment="Center"/>
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Edit button — top-right, EditMode ON -->
                                                <Button Content="✏" FontSize="10"
                                                        Width="20" Height="20"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Margin="0,2,44,0"
                                                        Foreground="{DynamicResource BrushAccentCyan}"
                                                        BorderThickness="0" Cursor="Hand"
                                                        ToolTip="Edit this clock"
                                                        Click="EditCard_Click" Tag="{Binding}">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="Bd" Background="Transparent"
                                                                                CornerRadius="10" Padding="2">
                                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                                              VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding Source={x:Static local:EditModeProxy.Instance}, Path=EditMode}" Value="True"/>
                                                                        <Condition Binding="{Binding IsEditing}" Value="False"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <!-- Home button — top-right, EditMode ON -->
                                                <Button Content="🏠" FontSize="10"
                                                        Width="20" Height="20"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Margin="0,2,22,0"
                                                        BorderThickness="0" Cursor="Hand"
                                                        ToolTip="Set as home location"
                                                        Click="SetHomeLocation_Click" Tag="{Binding}">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="Bd" Background="Transparent"
                                                                                CornerRadius="10" Padding="2">
                                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                                              VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding Source={x:Static local:EditModeProxy.Instance}, Path=EditMode}" Value="True"/>
                                                                        <Condition Binding="{Binding IsEditing}" Value="False"/>
                                                                        <Condition Binding="{Binding IsUtc}" Value="False"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <!-- Delete button — top-right, DeleteMode ON -->
                                                <Button Content="✕" FontSize="11"
                                                        Width="20" Height="20"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Margin="0,2,2,0"
                                                        Background="#C62828" Foreground="White"
                                                        BorderThickness="0" Cursor="Hand"
                                                        AutomationProperties.Name="DeleteCityButton"
                                                        Tag="{Binding}" Click="DeleteCard_Click">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="{TemplateBinding Background}"
                                                                                CornerRadius="10" Padding="2">
                                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                                              VerticalAlignment="Center"/>
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Source={x:Static local:DeleteModeProxy.Instance}, Path=DeleteMode}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Viewbox>
                    </DockPanel>
                </Border>

                <!-- ══════════════════════════════════════════════════════
                     RIGHT PANEL — Time Visualizer
                     Search ("Add city") is now at the TOP of the expanded
                     panel, immediately below the toggle bar.
                     Date navigation is integrated into the control strip.
                     The timeline grid is the dominant, wider surface.
                     ══════════════════════════════════════════════════════ -->
                <Border x:Name="VisualizerPanelBorder" Grid.Column="1"
                        Background="{DynamicResource BrushBackgroundMid}"
                        CornerRadius="0,10,10,0" Margin="2,0,0,0">
                    <!-- DockPanel: toggle button docked to top, collapsible section fills remaining height -->
                    <DockPanel>
                        <!-- Toggle bar -->
                        <Button DockPanel.Dock="Top"
                                Background="Transparent" BorderThickness="0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="16,10" Cursor="Hand"
                                AutomationProperties.Name="ToggleTranslatorButton"
                                Click="ToggleTranslator_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🕐" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <TextBlock.Effect>
                                            <DropShadowEffect Color="White" BlurRadius="24" ShadowDepth="0"
                                                              Opacity="{DynamicResource GlowOpacitySubtle}"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                    <TextBlock Text="TIME VISUALIZER"
                                               FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                                               Foreground="{DynamicResource BrushAccentCyan}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <Rectangle Grid.Column="1" Height="1" Margin="16,0"
                                           Fill="{DynamicResource BrushSeparator}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Translator.SelectionWindowLabel}"
                                               FontFamily="Consolas" FontSize="13" FontWeight="Bold"
                                               Foreground="{DynamicResource BrushAccentCyan}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Translator.IsOpen}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock FontFamily="Consolas" FontSize="14" FontWeight="Bold"
                                               Foreground="{DynamicResource BrushTextDim}" VerticalAlignment="Center"
                                               Margin="8,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="▶ pick a date &amp; time"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Translator.IsOpen}" Value="True">
                                                        <Setter Property="Text" Value="▼ collapse"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- DockPanel: search/date-nav docked to top, TranslatorResults fills remaining -->
                        <DockPanel Visibility="{Binding Translator.IsOpen, Converter={StaticResource BoolToVis}}">
                            <Border DockPanel.Dock="Top" Height="1" Margin="16,0" Background="{DynamicResource BrushSeparator}"/>

                            <!-- ① ADD-CITY SEARCH — prominent, at the top of the expanded panel -->
                            <Border DockPanel.Dock="Top" x:Name="GlobalCitySearchBar" Margin="12,10,12,0" CornerRadius="8"
                                    Background="{DynamicResource BrushBackgroundCard}">
                                <Grid Margin="12,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🔍" FontSize="14"
                                               VerticalAlignment="Center" Margin="0,0,10,0" Opacity="0.6"/>
                                    <Grid Grid.Column="1">
                                        <TextBox x:Name="GlobalCitySearchBox"
                                                 Background="Transparent" BorderThickness="0"
                                                 Foreground="{DynamicResource BrushTextPrimary}"
                                                 FontSize="17" CaretBrush="{DynamicResource BrushAccentCyan}"
                                                 VerticalContentAlignment="Center"
                                                 ToolTip="Type a city or country to add it to the timeline"
                                                 AutomationProperties.Name="AddCitySearch"
                                                 GotFocus="GlobalCitySearch_GotFocus"
                                                 TextChanged="GlobalCitySearch_TextChanged"
                                                 PreviewKeyDown="GlobalCitySearch_KeyDown"
                                                 LostFocus="GlobalCitySearch_LostFocus"/>
                                        <TextBlock x:Name="GlobalCitySearchPlaceholder"
                                                   Text="Add a city to the timeline…"
                                                   IsHitTestVisible="False" VerticalAlignment="Center"
                                                   Opacity="0.4" FontSize="17"
                                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Add-city search results -->
                            <Border DockPanel.Dock="Top" x:Name="GlobalSearchDropdown"
                                    Visibility="Collapsed"
                                    Background="{DynamicResource BrushBackgroundMid}"
                                    BorderBrush="{DynamicResource BrushAccentCyan}"
                                    BorderThickness="1" CornerRadius="0,0,8,8"
                                    Margin="12,0,12,0">
                                <ListBox x:Name="GlobalCitySearchList"
                                         AutomationProperties.Name="GlobalCitySearchList"
                                         MaxHeight="220"
                                         Background="{DynamicResource BrushBackgroundMid}"
                                         BorderThickness="0"
                                         KeyboardNavigation.DirectionalNavigation="None"
                                         VirtualizingPanel.IsVirtualizing="False"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         PreviewKeyDown="GlobalCitySearchList_PreviewKeyDown"
                                         MouseLeftButtonUp="GlobalCitySearchList_MouseSelect">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding"    Value="12,7"/>
                                            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                                            <Setter Property="Background" Value="{DynamicResource BrushBackgroundMid}"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <!-- Static default — no TemplateBinding so triggers are never blocked -->
                                                        <Border x:Name="Bd"
                                                                Background="{DynamicResource BrushBackgroundMid}"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushBackgroundCard}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushAccentCyan}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushAccentCyan}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding CountryFlag}" FontSize="20"
                                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding City}" FontSize="16"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                                                        <TextBlock Text="{Binding PrimaryCode}"
                                                                   FontSize="13" FontFamily="Consolas"
                                                                   Foreground="{DynamicResource BrushTextDim}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="6,0,0,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <Trigger Property="Text" Value="">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Country}" FontSize="13"
                                                               Foreground="{DynamicResource BrushTextDim}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>

                            <!-- ② CONTROL BAR — Date Navigator + Teams button -->
                            <Border DockPanel.Dock="Top" Margin="12,8,12,0" CornerRadius="8"
                                    Background="{DynamicResource BrushBackgroundCard}">
                                <Grid Margin="10,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Date navigator: ← date → Today -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                VerticalAlignment="Center" Margin="0,0,8,0">
                                        <Button Width="28" Height="28" Cursor="Hand"
                                                ToolTip="Previous day"
                                                AutomationProperties.Name="PrevDayButton"
                                                Click="TranslatorPrevDay_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" CornerRadius="5"
                                                            Background="Transparent">
                                                        <TextBlock Text="◀" FontFamily="Consolas" FontSize="12"
                                                                   Foreground="{DynamicResource BrushAccentCyan}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <TextBlock Text="{Binding Translator.DateLabel}"
                                                   FontFamily="Consolas" FontSize="13" FontWeight="Bold"
                                                   Foreground="{DynamicResource BrushTextPrimary}"
                                                   VerticalAlignment="Center" Margin="8,0"
                                                   MinWidth="90" TextAlignment="Center"/>
                                        <Button Width="28" Height="28" Cursor="Hand"
                                                ToolTip="Next day"
                                                AutomationProperties.Name="NextDayButton"
                                                Click="TranslatorNextDay_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" CornerRadius="5"
                                                            Background="Transparent">
                                                        <TextBlock Text="▶" FontFamily="Consolas" FontSize="12"
                                                                   Foreground="{DynamicResource BrushAccentCyan}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Button Height="28" Cursor="Hand" Margin="6,0,0,0"
                                                ToolTip="Jump to today"
                                                AutomationProperties.Name="TodayButton"
                                                Click="TranslatorToday_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" CornerRadius="5"
                                                            Background="Transparent" Padding="8,0">
                                                        <TextBlock Text="Today" FontFamily="Consolas" FontSize="12"
                                                                   Foreground="{DynamicResource BrushTextDim}"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>

                                    <!-- spacer -->
                                    <Rectangle Grid.Column="1" Height="1"
                                               Fill="{DynamicResource BrushSeparator}"
                                               VerticalAlignment="Center" Margin="4,0"/>

                                    <!-- Teams button -->
                                    <Button Grid.Column="2" Height="28" Cursor="Hand"
                                            ToolTip="Create a Microsoft Teams meeting for the selected time window"
                                            AutomationProperties.Name="CreateTeamsMeetingButton"
                                            Click="CreateTeamsMeeting_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" CornerRadius="6"
                                                        Background="#6264A7" Padding="10,0">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="📅" FontSize="12"
                                                                   Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Teams" FontFamily="Consolas"
                                                                   FontSize="12" FontWeight="Bold"
                                                                   Foreground="White"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#7B7FC4"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- ③ TIMELINE: row headers are inline result cards, one per timezone row -->
                            <Border Margin="8,4,8,4"
                                    Background="{DynamicResource BrushBackgroundDark}"
                                    CornerRadius="8" ClipToBounds="True"
                                    AutomationProperties.Name="TranslatorResults"
                                    PreviewMouseLeftButtonDown="GridArea_PreviewMouseDown"
                                    PreviewMouseMove="GridArea_PreviewMouseMove"
                                    PreviewMouseLeftButtonUp="GridArea_PreviewMouseUp">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="36"/>    <!-- column header -->
                                        <RowDefinition Height="*"/>     <!-- data rows: scrolls when rows overflow -->
                                        <RowDefinition Height="Auto"/>  <!-- debug bar: always visible at bottom -->
                                    </Grid.RowDefinitions>

                                    <!-- DEBUG STATUS BAR — shows model state for diagnosis -->
                                    <Border Grid.Row="2" Background="#CC000000" Padding="8,2">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      MaxHeight="70">
                                            <TextBlock Text="{Binding Translator.DiagStatus}"
                                                       FontFamily="Consolas" FontSize="9"
                                                       Foreground="#FFFF00"
                                                       TextWrapping="Wrap"/>
                                        </ScrollViewer>
                                    </Border>

                                    <!-- Column-header row: 160px spacer + hour labels -->
                                    <Border Grid.Row="0"
                                            Background="{DynamicResource BrushBackgroundMid}"
                                            BorderBrush="{DynamicResource BrushSeparator}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <!-- Layer 1: per-slot selection highlight (10px per slot).
                                                 All 48 slots are always visible; each lights up via IsSelected
                                                 when that individual 30-min slot is within the selection range. -->
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="160" Background="{DynamicResource BrushBackgroundMid}"/>
                                                <ItemsControl ItemsSource="{Binding Translator.Columns}">
                                                    <ItemsControl.ItemContainerStyle>
                                                        <Style TargetType="ContentPresenter">
                                                            <Setter Property="Canvas.Left" Value="{Binding SlotIndex, Converter={StaticResource SlotToPx}}"/>
                                                            <Setter Property="Canvas.Top"  Value="0"/>
                                                        </Style>
                                                    </ItemsControl.ItemContainerStyle>
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <Canvas Width="480" Height="36"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <!-- Width=10 covers exactly one 30-min slot. -->
                                                            <Border Width="10" Height="36" Cursor="Hand">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Setter Property="Background" Value="Transparent"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                <Setter Property="Background" Value="#2000E5FF"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                            <!-- Layer 2: hour labels (40px per pair, on top via Grid Z-order, hit-test transparent) -->
                                            <ItemsControl ItemsSource="{Binding Translator.Columns}" Margin="160,0,0,0"
                                                          IsHitTestVisible="False">
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="Canvas.Left" Value="{Binding SlotIndex, Converter={StaticResource SlotToPx}}"/>
                                                        <Setter Property="Canvas.Top"  Value="0"/>
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Canvas Width="480" Height="36" HorizontalAlignment="Left"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <!-- Width=20 spans exactly the :00 slot (10px) and the :30 slot (10px)
                                                             of each hour pair.  Height=36 matches the header row so the inner
                                                             Grid's VerticalAlignment=Center works over the full header height.
                                                             Collapsed for :30 slots (DesiredSize=0, no rendering). -->
                                                        <Border Width="20" Height="36" Background="Transparent">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsHourStart}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Grid VerticalAlignment="Center">
                                                                <!-- Midnight slot: show weekday + date -->
                                                                <StackPanel>
                                                                    <StackPanel.Style>
                                                                        <Style TargetType="StackPanel">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsMidnight}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </StackPanel.Style>
                                                                    <TextBlock Text="{Binding DayOfWeekLabel}"
                                                                               FontFamily="Consolas" FontSize="10" FontWeight="Bold"
                                                                               Foreground="{DynamicResource BrushAccentCyan}"
                                                                               HorizontalAlignment="Center"
                                                                               LineHeight="13"/>
                                                                    <TextBlock Text="{Binding DateShortLabel}"
                                                                               FontFamily="Consolas" FontSize="12"
                                                                               Foreground="{DynamicResource BrushTextDim}"
                                                                               HorizontalAlignment="Center"
                                                                               LineHeight="12"/>
                                                                </StackPanel>
                                                                <!-- All other hour slots: show hour + am/pm -->
                                                                <StackPanel>
                                                                    <StackPanel.Style>
                                                                        <Style TargetType="StackPanel">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsMidnight}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </StackPanel.Style>
                                                                    <TextBlock Text="{Binding SlotHour}"
                                                                               FontFamily="Consolas" FontSize="12"
                                                                               Foreground="{DynamicResource BrushTextDim}"
                                                                               HorizontalAlignment="Center"
                                                                               LineHeight="15"/>
                                                                    <TextBlock Text="{Binding SlotAmPm}"
                                                                               FontFamily="Consolas" FontSize="12"
                                                                               Foreground="{DynamicResource BrushTextDim}"
                                                                               HorizontalAlignment="Center"
                                                                               LineHeight="12"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <!-- Layer 3: current-time needle (header strip) — also covered by spanning needle below -->
                                            <Canvas IsHitTestVisible="False" HorizontalAlignment="Left" Height="36">
                                                <Rectangle
                                                    Canvas.Left="{Binding Translator.CurrentTimeLeft}"
                                                    Canvas.Top="0" Width="2" Height="36">
                                                    <Rectangle.Style>
                                                        <Style TargetType="Rectangle">
                                                            <Setter Property="Fill" Value="#00E5FF"/>
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Translator.ShowCurrentTime}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Rectangle.Style>
                                                </Rectangle>
                                            </Canvas>
                                        </Grid>
                                    </Border>

                                    <!-- Scrollable city rows — each row has an inline result card on the left -->
                                    <ScrollViewer Grid.Row="1"
                                                  x:Name="GridScrollViewer"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding Translator.Rows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Height="44">
                                                        <!-- Layer 1: band backgrounds, selection overlay, day-change bar -->
                                                        <StackPanel Orientation="Horizontal">

                                                        <!-- ▌ Row header card (160px, 2-line compact layout) -->
                                                        <Border Width="160" Height="44"
                                                                Background="{DynamicResource BrushBackgroundMid}"
                                                                BorderBrush="{DynamicResource BrushSeparator}"
                                                                BorderThickness="0,0,1,1"
                                                                ClipToBounds="True">
                                                            <Grid>
                                                                <!-- Left accent bar -->
                                                                <Border HorizontalAlignment="Left"
                                                                        VerticalAlignment="Stretch"
                                                                        Width="3"
                                                                        Background="{Binding ThemedAccentBrush}"/>
                                                                <!-- 3-section grid:  [city|time|weekday] -->
                                                                <Grid Margin="3,2,2,2" VerticalAlignment="Center">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>      <!-- city -->
                                                                        <ColumnDefinition Width="Auto"/>   <!-- time range -->
                                                                        <ColumnDefinition Width="Auto"/>   <!-- date/weekday -->
                                                                    </Grid.ColumnDefinitions>
                                                                    <!-- Col 0: Flag + CityName / UTC offset + DST -->
                                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="{Binding CountryFlag}"
                                                                                       FontSize="16" VerticalAlignment="Center"
                                                                                       Margin="0,0,2,0"/>
                                                                            <TextBlock Text="{Binding CityName}"
                                                                                       FontSize="13" FontWeight="Bold"
                                                                                       Foreground="{DynamicResource BrushTextPrimary}"
                                                                                       TextTrimming="CharacterEllipsis"
                                                                                       MaxWidth="106" VerticalAlignment="Center"/>
                                                                        </StackPanel>
                                                                        <TextBlock Text="{Binding UtcOffset}"
                                                                                   FontFamily="Consolas" FontSize="12"
                                                                                   Foreground="{Binding ThemedAccentBrush}"/>
                                                                    </StackPanel>
                                                                    <!-- Col 1: Time range (visible after selection) -->
                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                                                                Margin="4,0,4,0">
                                                                        <StackPanel.Style>
                                                                            <Style TargetType="StackPanel">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding ShowTranslatedTime}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </StackPanel.Style>
                                                                        <!-- Start → End time -->
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="{Binding SelectedTimeStr}"
                                                                                       FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                                                                                       Foreground="{Binding ThemedAccentBrush}">
                                                                                <TextBlock.Effect>
                                                                                    <DropShadowEffect BlurRadius="6" ShadowDepth="0"
                                                                                                      Opacity="{DynamicResource GlowOpacity}"
                                                                                                      Color="#00BFFF"/>
                                                                                </TextBlock.Effect>
                                                                            </TextBlock>
                                                                            <!-- Arrow + end time (range only) -->
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <StackPanel.Style>
                                                                                    <Style TargetType="StackPanel">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding HasRange}" Value="True">
                                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </StackPanel.Style>
                                                                                <TextBlock Text="→" FontFamily="Consolas" FontSize="12"
                                                                                           Foreground="{DynamicResource BrushTextDim}"
                                                                                           VerticalAlignment="Center" Margin="2,0"/>
                                                                                <TextBlock Text="{Binding SelectedEndTimeStr}"
                                                                                           FontFamily="Consolas" FontSize="16" FontWeight="Bold"
                                                                                           Foreground="{Binding ThemedAccentBrush}">
                                                                                    <TextBlock.Effect>
                                                                                        <DropShadowEffect BlurRadius="6" ShadowDepth="0"
                                                                                                          Opacity="{DynamicResource GlowOpacity}"
                                                                                                          Color="#00BFFF"/>
                                                                                    </TextBlock.Effect>
                                                                                </TextBlock>
                                                                            </StackPanel>
                                                                        </StackPanel>
                                                                        <!-- Day diff indicator -->
                                                                        <TextBlock FontFamily="Consolas" FontSize="13"
                                                                                   Foreground="{DynamicResource BrushTextDim}">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Text" Value=""/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding DateDayDiff}" Value="1">
                                                                                            <Setter Property="Text" Value="+1 day"/>
                                                                                            <Setter Property="Foreground" Value="#FF8C00"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                    <!-- Col 2: Weekday / Date (visible after selection) -->
                                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                                        <StackPanel.Style>
                                                                            <Style TargetType="StackPanel">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding ShowTranslatedTime}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </StackPanel.Style>
                                                                        <!-- e.g. "Wed" -->
                                                                        <TextBlock FontFamily="Consolas" FontSize="13" FontWeight="Bold"
                                                                                   Foreground="{DynamicResource BrushTextPrimary}">
                                                                            <TextBlock.Text>
                                                                                <Binding Path="DateLabel"
                                                                                         StringFormat="{}{0:ddd}"
                                                                                         ConverterCulture="en-US"/>
                                                                            </TextBlock.Text>
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Text" Value="{Binding DateLabel}"/>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                        <!-- DST badge -->
                                                                        <Border CornerRadius="2" Padding="2,0"
                                                                                Background="{DynamicResource BrushBackgroundDark}">
                                                                            <TextBlock Text="{Binding DstLabel}"
                                                                                       FontFamily="Consolas" FontSize="11"
                                                                                       FontWeight="Bold">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource BrushTextDim}"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsDst}" Value="True">
                                                                                                <Setter Property="Foreground" Value="{DynamicResource BrushDstActive}"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                        </Border>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Grid>
                                                        </Border>
                                                        <!-- Inner Grid spans the 480px timeline area; both Layer 1a and Layer 1b
                                                             share this origin so the highlight aligns with the band backgrounds
                                                             without any Margin offset. -->
                                                        <Grid Width="480" Height="44">
                                                        <!-- Data-row Layer 1a: band background + day-change bar (10px per slot) -->
                                                        <ItemsControl ItemsSource="{Binding Cells}">
                                                            <ItemsControl.ItemContainerStyle>
                                                                <Style TargetType="ContentPresenter">
                                                                    <Setter Property="Canvas.Left" Value="{Binding SlotIndex, Converter={StaticResource SlotToPx}}"/>
                                                                    <Setter Property="Canvas.Top"  Value="0"/>
                                                                </Style>
                                                            </ItemsControl.ItemContainerStyle>
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <Canvas Width="480" Height="44"/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Width="10" Height="44"
                                                                            Background="{Binding Background}"
                                                                            BorderBrush="{DynamicResource BrushSeparator}"
                                                                            BorderThickness="0,0,0,1">
                                                                        <!-- Day-change indicator bar at top -->
                                                                        <Border VerticalAlignment="Top" Height="2">
                                                                            <Border.Style>
                                                                                <Style TargetType="Border">
                                                                                    <Setter Property="Background" Value="Transparent"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding DayDiff}" Value="+1">
                                                                                            <Setter Property="Background" Value="#80FF8C00"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Border.Style>
                                                                        </Border>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <!-- Data-row Layer 1b: per-slot selection highlight (10px per slot).
                                                             All 48 slots are always visible; each lights up via IsSelected
                                                             when that individual 30-min slot is within the selection range. -->
                                                        <ItemsControl ItemsSource="{Binding Cells}"
                                                                      IsHitTestVisible="False">
                                                            <ItemsControl.ItemContainerStyle>
                                                                <Style TargetType="ContentPresenter">
                                                                    <Setter Property="Canvas.Left" Value="{Binding SlotIndex, Converter={StaticResource SlotToPx}}"/>
                                                                    <Setter Property="Canvas.Top"  Value="0"/>
                                                                </Style>
                                                            </ItemsControl.ItemContainerStyle>
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <Canvas Width="480" Height="44"/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Width="10" Height="44">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                <Setter Property="Background" Value="Transparent"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                        <Setter Property="Background" Value="#6000E5FF"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        </Grid>
                                                        </StackPanel>

                                                        <!-- Layer 2: hour labels (40px per pair, on top via Grid Z-order, hit-test transparent) -->
                                                        <ItemsControl ItemsSource="{Binding Cells}" Margin="160,0,0,0"
                                                                      IsHitTestVisible="False">
                                                            <ItemsControl.ItemContainerStyle>
                                                                <Style TargetType="ContentPresenter">
                                                                    <Setter Property="Canvas.Left" Value="{Binding SlotIndex, Converter={StaticResource SlotToPx}}"/>
                                                                    <Setter Property="Canvas.Top"  Value="0"/>
                                                                </Style>
                                                            </ItemsControl.ItemContainerStyle>
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <Canvas Width="480" Height="44" HorizontalAlignment="Left"/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <!-- Width=20 forces Canvas to arrange this ContentPresenter at 20px,
                                                                         spanning both the hour cell and the :30 cell of the pair.
                                                                         Collapsed for :30 slots (DesiredSize=0, no rendering). -->
                                                                    <Border Width="20" Height="44" Background="Transparent">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsHourSlot}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                        <StackPanel VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding TimeHourPart}"
                                                                                       FontFamily="Consolas" FontSize="16"
                                                                                       Foreground="{Binding Foreground}"
                                                                                       HorizontalAlignment="Center"
                                                                                       LineHeight="15"/>
                                                                            <TextBlock Text="{Binding TimeAmPmPart}"
                                                                                       FontFamily="Consolas" FontSize="12"
                                                                                       Foreground="{Binding Foreground}"
                                                                                       HorizontalAlignment="Center"
                                                                                       LineHeight="12"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <!-- Layer 3: current-time needle (today only) -->
                                                        <Canvas IsHitTestVisible="False" HorizontalAlignment="Left" Height="44">
                                                            <Rectangle
                                                                Canvas.Left="{Binding CurrentTimeLeft}"
                                                                Canvas.Top="0" Width="2" Height="44">
                                                                <Rectangle.Style>
                                                                    <Style TargetType="Rectangle">
                                                                        <Setter Property="Fill" Value="#00E5FF"/>
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding ShowCurrentTime}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Rectangle.Style>
                                                            </Rectangle>
                                                        </Canvas>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <!-- Spanning cyan needle: overlays both the column header and all data rows -->
                                    <Canvas Grid.Row="0" Grid.RowSpan="2"
                                            IsHitTestVisible="False" HorizontalAlignment="Left">
                                        <Rectangle
                                            Canvas.Left="{Binding Translator.CurrentTimeLeft}"
                                            Canvas.Top="0" Width="2" Height="9999">
                                            <Rectangle.Style>
                                                <Style TargetType="Rectangle">
                                                    <Setter Property="Fill" Value="#CC00E5FF"/>
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Translator.ShowCurrentTime}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Rectangle.Style>
                                        </Rectangle>
                                    </Canvas>
                                </Grid>
                            </Border>
                        </DockPanel>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- FOOTER -->
            <Border Grid.Row="3" Background="{DynamicResource BrushBackgroundMid}" Padding="16,8">
                <TextBlock Text="© 2026 World Clock  •  All times update every second  •  Built with .NET 8 WPF"
                           FontSize="10" Foreground="{DynamicResource BrushTextDim}"
                           HorizontalAlignment="Center"/>
            </Border>
        </Grid>
    </Border>

            </Grid>
        </Viewbox>
    </ScrollViewer>
</Window>
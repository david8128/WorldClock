<Window x:Class="WorldClock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WorldClock"
        mc:Ignorable="d"
        Title="World Clock" Icon="Images/Logo.ico" Height="760" Width="1100"
        MinHeight="300" MinWidth="430"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        FontFamily="Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome x:Name="AppWindowChrome"
                      CaptionHeight="72"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="DigitalTime" TargetType="TextBlock">
            <Setter Property="FontFamily"    Value="Consolas"/>
            <Setter Property="FontSize"      Value="46"/>
            <Setter Property="FontWeight"    Value="Bold"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CityLabel" TargetType="TextBlock">
            <Setter Property="FontSize"      Value="18"/>
            <Setter Property="FontWeight"    Value="SemiBold"/>
            <Setter Property="Foreground"    Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SubLabel" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="11"/>
            <Setter Property="Foreground"   Value="{DynamicResource BrushTextDim}"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <!-- Frameless window control buttons -->
        <Style x:Key="WinCtrlBtn" TargetType="Button">
            <Setter Property="Width"           Value="46"/>
            <Setter Property="Height"          Value="36"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground"      Value="{DynamicResource BrushTextDim}"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WinCloseBtn" TargetType="Button" BasedOn="{StaticResource WinCtrlBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C00C0C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact TextBox for inline card editing -->
        <Style x:Key="CardEditBox" TargetType="TextBox">
            <Setter Property="Padding"                  Value="6,4"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="BorderBrush"              Value="{DynamicResource BrushSeparator}"/>
            <Setter Property="Background"               Value="{DynamicResource BrushBackgroundDark}"/>
            <Setter Property="Foreground"               Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="FontSize"                 Value="12"/>
            <Setter Property="CaretBrush"               Value="{DynamicResource BrushAccentCyan}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource BrushAccentCyan}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Responsive root: the inner Grid grows to fill the window at any size.
         ScaleScrollViewer + ScaleViewbox + DesignRoot are kept as named elements
         so the code-behind ApplyScaleMode() method can still reference them
         without errors; they just don't constrain the layout anymore. -->
    <ScrollViewer x:Name="ScaleScrollViewer"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  Background="{DynamicResource BrushBackgroundDark}">
        <!-- Viewbox is kept for ProportionScale mode but defaults to pass-through -->
        <Viewbox x:Name="ScaleViewbox" Stretch="None">
            <Grid x:Name="DesignRoot"
                  Width="{Binding ActualWidth,
                         RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                  MinHeight="300">

    <!-- Root: semi-transparent so the acrylic blur shows through when opacity < 1 -->
    <Border Background="{DynamicResource BrushBackgroundDark}">
        <Grid x:Name="LayoutRoot">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- 0: header -->
                <RowDefinition Height="Auto"/>  <!-- 1: UTC banner -->
                <RowDefinition Height="Auto"/>  <!-- 2: time translator -->
                <RowDefinition Height="Auto"/>  <!-- 3: add-city search bar -->
                <RowDefinition Height="*"/>     <!-- 4: location cards -->
                <RowDefinition Height="Auto"/>  <!-- 5: footer -->
            </Grid.RowDefinitions>

            <!-- HEADER / TITLE BAR -->
            <Border Grid.Row="0"
                    Background="{DynamicResource BrushBackgroundMid}"
                    Padding="24,10,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🌍" FontSize="28" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="White" BlurRadius="24" ShadowDepth="0"
                                                  Opacity="{DynamicResource GlowOpacitySubtle}"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="WORLD CLOCK"
                                       FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource BrushAccentCyan}"
                                       FontFamily="Consolas"/>
                            <TextBlock Text="Global Team Time Tracker"
                                       FontSize="11"
                                       Foreground="{DynamicResource BrushTextDim}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Stretch" HorizontalAlignment="Right">
                        <TextBlock x:Name="HeaderDate"
                                   FontSize="12" Foreground="{DynamicResource BrushTextPrimary}"
                                   FontFamily="Consolas"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                        <Button x:Name="SettingsButton"
                                Content="⚙" FontSize="18"
                                Width="40" Height="40"
                                Background="Transparent" BorderThickness="0"
                                Foreground="{DynamicResource BrushAccentCyan}"
                                Cursor="Hand" ToolTip="Open Settings"
                                AutomationProperties.Name="SettingsButton"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="SettingsButton_Click"/>
                        <Rectangle Width="1" Fill="{DynamicResource BrushSeparator}"
                                   Margin="6,8" VerticalAlignment="Stretch"/>
                        <Button Content="─" Style="{StaticResource WinCtrlBtn}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="MinimizeWindow_Click" ToolTip="Minimize"/>
                        <Button x:Name="MaximizeButton" Content="□"
                                Style="{StaticResource WinCtrlBtn}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="MaximizeWindow_Click" ToolTip="Maximize"/>
                        <Button Content="✕" Style="{StaticResource WinCloseBtn}"
                                Foreground="White"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="CloseWindow_Click" ToolTip="Close"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- UTC BANNER -->
            <Border Grid.Row="1" Margin="16,10,16,0" CornerRadius="12" Padding="24,16">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{DynamicResource BannerGradientStart}" Offset="0"/>
                        <GradientStop Color="{DynamicResource BannerGradientEnd}" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect Color="#00E5FF" BlurRadius="20" ShadowDepth="0"
                                      Opacity="{DynamicResource GlowOpacitySubtle}"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Text="🌐" FontSize="34" HorizontalAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="White" BlurRadius="24" ShadowDepth="0"
                                                  Opacity="{DynamicResource GlowOpacitySubtle}"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="Universal Time" FontSize="10"
                                   Foreground="{DynamicResource BrushTextDim}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="UtcTime"
                                   Style="{StaticResource DigitalTime}" FontSize="58"
                                   Foreground="{DynamicResource BrushAccentCyan}">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#00E5FF" BlurRadius="24" ShadowDepth="0"
                                                  Opacity="{DynamicResource GlowOpacity}"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock x:Name="UtcDate" FontSize="13" FontFamily="Consolas"
                                   Foreground="{DynamicResource BrushTextDim}" TextAlignment="Center" Margin="0,2,0,0"/>
                        <TextBlock Text="— STD" FontFamily="Consolas" FontSize="10"
                                   Foreground="{DynamicResource BrushTextDim}"
                                   TextAlignment="Center" Margin="0,2,0,0"
                                   ToolTip="UTC has no daylight saving time"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="20,0,0,0">
                        <TextBlock Text="UTC+00:00" FontFamily="Consolas" FontSize="13"
                                   Foreground="{DynamicResource BrushAccentCyan}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Coordinated" FontSize="9"
                                   Foreground="{DynamicResource BrushTextDim}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Universal Time" FontSize="9"
                                   Foreground="{DynamicResource BrushTextDim}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- TIME TRANSLATOR -->
            <Border Grid.Row="2"
                    Background="{DynamicResource BrushBackgroundMid}"
                    Margin="16,10,16,0" CornerRadius="10">
                <StackPanel>
                    <!-- Toggle bar -->
                    <Button Background="Transparent" BorderThickness="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="16,10" Cursor="Hand"
                            AutomationProperties.Name="ToggleTranslatorButton"
                            Click="ToggleTranslator_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🕐" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="White" BlurRadius="24" ShadowDepth="0"
                                                          Opacity="{DynamicResource GlowOpacitySubtle}"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                                <TextBlock Text="TIME TRANSLATOR"
                                           FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                                           Foreground="{DynamicResource BrushAccentCyan}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <Rectangle Grid.Column="1" Height="1" Margin="16,0"
                                       Fill="{DynamicResource BrushSeparator}" VerticalAlignment="Center"/>
                            <!-- Selection window label (shows e.g. "09:00 – 10:30") -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Translator.SelectionWindowLabel}"
                                           FontFamily="Consolas" FontSize="13" FontWeight="Bold"
                                           Foreground="{DynamicResource BrushAccentCyan}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Translator.IsOpen}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource BrushTextDim}" VerticalAlignment="Center"
                                           Margin="8,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="▶ pick a date &amp; time"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Translator.IsOpen}" Value="True">
                                                    <Setter Property="Text" Value="▼ collapse"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <StackPanel Visibility="{Binding Translator.IsOpen, Converter={StaticResource BoolToVis}}">
                        <Border Height="1" Margin="16,0" Background="{DynamicResource BrushSeparator}"/>

                        <!-- Control row: date navigation + source city search -->
                        <Grid Margin="12,8,12,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Date navigation -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="◀" Width="22" Height="22"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="{DynamicResource BrushTextPrimary}"
                                        FontFamily="Consolas" FontSize="10" Cursor="Hand"
                                        Click="TranslatorPrevDay_Click" ToolTip="Previous day">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <TextBlock Text="{Binding Translator.DateLabel}"
                                           FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource BrushAccentCyan}"
                                           VerticalAlignment="Center" Margin="6,0"/>
                                <Button Content="▶" Width="22" Height="22"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="{DynamicResource BrushTextPrimary}"
                                        FontFamily="Consolas" FontSize="10" Cursor="Hand"
                                        Click="TranslatorNextDay_Click" ToolTip="Next day">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Content="Today" Height="20" Padding="8,0"
                                        Background="Transparent" BorderThickness="1"
                                        BorderBrush="{DynamicResource BrushSeparator}"
                                        Foreground="{DynamicResource BrushAccentCyan}"
                                        FontFamily="Consolas" FontSize="9" Cursor="Hand"
                                        Margin="6,0,0,0"
                                        Click="TranslatorToday_Click" ToolTip="Jump to today">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>

                            <!-- Source city searchable selector -->
                            <Border Grid.Column="1" Background="{DynamicResource BrushBackgroundCard}"
                                    CornerRadius="6" Margin="12,0,0,0" Padding="10,5">
                                <DockPanel>
                                    <TextBlock Text="FROM" DockPanel.Dock="Left"
                                               FontFamily="Consolas" FontSize="9" FontWeight="Bold"
                                               Foreground="{DynamicResource BrushTextDim}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Grid>
                                        <TextBox x:Name="SourceCityBox"
                                                 Text="{Binding Translator.SourceCitySearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="Transparent" BorderThickness="0"
                                                 Foreground="{DynamicResource BrushTextPrimary}"
                                                 FontSize="12" CaretBrush="{DynamicResource BrushAccentCyan}"
                                                 VerticalContentAlignment="Center"
                                                 ToolTip="Type a city or country name to search"
                                                 AutomationProperties.Name="SourceCitySearch"
                                                 GotFocus="SourceCityBox_GotFocus"
                                                 TextChanged="SourceCityBox_TextChanged"
                                                 LostFocus="SourceCityBox_LostFocus"/>
                                        <TextBlock x:Name="SourceCityPlaceholder"
                                                   Text="Type a city, code or country…"
                                                   IsHitTestVisible="False"
                                                   VerticalAlignment="Center"
                                                   Opacity="0.4" FontSize="12"
                                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                                        <Popup x:Name="SourceCityPopup"
                                               PlacementTarget="{x:Reference SourceCityBox}"
                                               Placement="Bottom"
                                               AllowsTransparency="True"
                                               StaysOpen="True">
                                            <Border Background="{DynamicResource BrushBackgroundMid}"
                                                    BorderBrush="{DynamicResource BrushSeparator}"
                                                    BorderThickness="1" CornerRadius="0,0,6,6"
                                                    MinWidth="260">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#000000" BlurRadius="12"
                                                                      ShadowDepth="4" Opacity="0.8"/>
                                                </Border.Effect>
                                                <ListBox x:Name="SourceCityList"
                                                         ItemsSource="{Binding Translator.SourceCityMatches}"
                                                         MaxHeight="180"
                                                         Background="Transparent" BorderThickness="0"
                                                         SelectionChanged="SourceCityList_SelectionChanged">
                                                    <ListBox.ItemContainerStyle>
                                                        <Style TargetType="ListBoxItem">
                                                            <Setter Property="Padding"    Value="10,6"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="ListBoxItem">
                                                                        <Border x:Name="Bd"
                                                                                Background="{TemplateBinding Background}"
                                                                                Padding="{TemplateBinding Padding}">
                                                                            <ContentPresenter/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </ListBox.ItemContainerStyle>
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <!-- City info (selects as source) -->
                                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding CountryFlag}" FontSize="14"
                                                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                                    <TextBlock Text="{Binding City}" FontSize="12"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource BrushTextPrimary}"
                                                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                                    <TextBlock Text="{Binding Country}" FontSize="10"
                                                                               Foreground="{DynamicResource BrushTextDim}"
                                                                               VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                                <!-- Add-to-clocks button -->
                                                                <Button Grid.Column="1"
                                                                        Content="+" FontSize="14" FontWeight="Bold"
                                                                        Width="24" Height="24"
                                                                        Margin="8,0,2,0"
                                                                        Background="Transparent"
                                                                        Foreground="{DynamicResource BrushAccentCyan}"
                                                                        BorderThickness="0" Cursor="Hand"
                                                                        ToolTip="Add to clocks"
                                                                        Tag="{Binding}"
                                                                        Click="AddCityFromTranslator_Click">
                                                                    <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="Bd" Background="Transparent"
                                                                                    CornerRadius="4" Padding="2">
                                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                                  VerticalAlignment="Center"/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="Bd" Property="Background" Value="#3300E5FF"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Button.Template>
                                                                </Button>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </DockPanel>
                            </Border>
                        </Grid>

                        <!-- WTB-style transposed grid: rows = cities, columns = half-hour slots -->
                        <Border Background="{DynamicResource BrushBackgroundDark}"
                                Margin="8,0,8,4" CornerRadius="8" ClipToBounds="True"
                                PreviewMouseLeftButtonDown="GridArea_PreviewMouseDown"
                                PreviewMouseMove="GridArea_PreviewMouseMove"
                                PreviewMouseLeftButtonUp="GridArea_PreviewMouseUp">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="22"/>
                                    <RowDefinition Height="Auto" MaxHeight="220"/>
                                </Grid.RowDefinitions>

                                <!-- Pinned column-header row: hour labels over 20px-wide slot columns -->
                                <Border Grid.Row="0"
                                        Background="{DynamicResource BrushBackgroundMid}"
                                        BorderBrush="{DynamicResource BrushSeparator}"
                                        BorderThickness="0,0,0,1">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- 90px spacer matches row-header width below -->
                                        <Border Width="90"
                                                Background="{DynamicResource BrushBackgroundMid}"/>
                                        <!-- 48 slot headers at 20px each -->
                                        <ItemsControl ItemsSource="{Binding Translator.Columns}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="20" Height="22"
                                                            Cursor="Hand">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="Transparent"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="Background" Value="#2000E5FF"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <!-- Label only on :00 slots -->
                                                        <TextBlock Text="{Binding SlotLabel}"
                                                                   FontFamily="Consolas" FontSize="8"
                                                                   Foreground="{DynamicResource BrushTextDim}"
                                                                   HorizontalAlignment="Left"
                                                                   VerticalAlignment="Center"
                                                                   Margin="2,0,0,0"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Scrollable city rows -->
                                <ScrollViewer Grid.Row="1"
                                              x:Name="GridScrollViewer"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding Translator.Rows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <!-- Each row: frozen 90px header + 48 × 20px cells -->
                                                <StackPanel Orientation="Horizontal" Height="46">
                                                    <!-- Row header: flag, city, UTC offset, date label -->
                                                    <Border Width="90" Padding="5,3"
                                                            Background="{DynamicResource BrushBackgroundMid}"
                                                            BorderBrush="{DynamicResource BrushSeparator}"
                                                            BorderThickness="0,0,1,1">
                                                        <StackPanel VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding CountryFlag}"
                                                                           FontSize="11"
                                                                           VerticalAlignment="Center"
                                                                           Margin="0,0,3,0"/>
                                                                <TextBlock Text="{Binding CityName}"
                                                                           FontSize="9" FontWeight="Bold"
                                                                           Foreground="{DynamicResource BrushTextPrimary}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           MaxWidth="64"
                                                                           VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding UtcOffset}"
                                                                       FontFamily="Consolas" FontSize="7"
                                                                       Foreground="{Binding AccentBrush}"/>
                                                            <!-- Date label: orange = +1 day, slate-blue = -1 day, dim = same -->
                                                            <TextBlock Text="{Binding DateLabel}"
                                                                       FontFamily="Consolas" FontSize="7">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground"
                                                                                Value="{DynamicResource BrushTextDim}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding DateDayDiff}" Value="1">
                                                                                <Setter Property="Foreground" Value="#FF8C00"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding DateDayDiff}" Value="-1">
                                                                                <Setter Property="Foreground" Value="#6A5ACD"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>
                                                    <!-- 48 half-hour cells -->
                                                    <ItemsControl ItemsSource="{Binding Cells}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Width="20" Height="46"
                                                                        Background="{Binding Background}"
                                                                        BorderBrush="{DynamicResource BrushSeparator}"
                                                                        BorderThickness="0,0,0,1">
                                                                    <!-- Selection + day-diff overlay -->
                                                                    <Border>
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="Background" Value="Transparent"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                        <Setter Property="Background" Value="#6000E5FF"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                        <!-- Thin top stripe: orange = next day, slate = prev day -->
                                                                        <Border VerticalAlignment="Top" Height="3">
                                                                            <Border.Style>
                                                                                <Style TargetType="Border">
                                                                                    <Setter Property="Background" Value="Transparent"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding DayDiff}" Value="+1">
                                                                                            <Setter Property="Background" Value="#80FF8C00"/>
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding DayDiff}" Value="-1">
                                                                                            <Setter Property="Background" Value="#806A5ACD"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Border.Style>
                                                                        </Border>
                                                                    </Border>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- Selected-hour result cards -->
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled"
                                      Margin="8,0,8,10"
                                      AutomationProperties.Name="TranslatorResults">
                            <ItemsControl ItemsSource="{Binding Translator.Results}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardBorder}" Width="160" Padding="14,12">
                                            <Grid>
                                                <Border HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                                        Width="3" CornerRadius="3"
                                                        Margin="-14,-12,0,-12"
                                                        Background="{Binding AccentBrush}"/>
                                                <StackPanel Margin="6,0,0,0">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding CountryFlag}" FontSize="16"
                                                                   VerticalAlignment="Center" Margin="0,0,6,0">
                                                            <TextBlock.Effect>
                                                                <DropShadowEffect Color="White" BlurRadius="24"
                                                                                  ShadowDepth="0"
                                                                                  Opacity="{DynamicResource GlowOpacitySubtle}"/>
                                                            </TextBlock.Effect>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding CityName}"
                                                                   FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource BrushTextPrimary}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" MaxWidth="90"/>
                                                    </StackPanel>
                                                    <!-- Start time: large when single slot, smaller when range -->
                                                    <TextBlock Text="{Binding TimeStr}"
                                                               FontFamily="Consolas" FontWeight="Bold"
                                                               Foreground="{Binding AccentBrush}"
                                                               TextAlignment="Center" Margin="0,6,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="FontSize" Value="30"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasRange}" Value="True">
                                                                        <Setter Property="FontSize" Value="20"/>
                                                                        <Setter Property="Margin"   Value="0,4,0,0"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                        <TextBlock.Effect>
                                                            <DropShadowEffect BlurRadius="10" ShadowDepth="0"
                                                                              Opacity="{DynamicResource GlowOpacity}" Color="#00BFFF"/>
                                                        </TextBlock.Effect>
                                                    </TextBlock>
                                                    <!-- End time — only visible when a range is selected -->
                                                    <StackPanel Orientation="Horizontal"
                                                                HorizontalAlignment="Center"
                                                                Visibility="{Binding HasRange, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="→ " FontFamily="Consolas" FontSize="11"
                                                                   Foreground="{DynamicResource BrushTextDim}"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding EndTimeStr}"
                                                                   FontFamily="Consolas" FontSize="16" FontWeight="Bold"
                                                                   Foreground="{Binding AccentBrush}"
                                                                   VerticalAlignment="Center">
                                                            <TextBlock.Effect>
                                                                <DropShadowEffect BlurRadius="8" ShadowDepth="0"
                                                                                  Opacity="{DynamicResource GlowOpacity}" Color="#00BFFF"/>
                                                            </TextBlock.Effect>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding DateStr}"
                                                               FontFamily="Consolas" FontSize="9"
                                                               Foreground="{DynamicResource BrushTextDim}"
                                                               TextAlignment="Center"/>
                                                    <Border Height="1" Margin="0,6"
                                                            Background="{DynamicResource BrushSeparator}"/>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <Border CornerRadius="3" Padding="5,2" Margin="0,0,6,0"
                                                                Background="{DynamicResource BrushBackgroundDark}">
                                                            <TextBlock Text="{Binding DstLabel}"
                                                                       FontFamily="Consolas" FontSize="9">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource BrushTextDim}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsDst}" Value="True">
                                                                                <Setter Property="Foreground" Value="{DynamicResource BrushDstActive}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                        <TextBlock Text="{Binding UtcOffset}"
                                                                   FontFamily="Consolas" FontSize="9"
                                                                   Foreground="{Binding AccentBrush}"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ADD-CITY GLOBAL SEARCH BAR -->
            <Border x:Name="GlobalCitySearchBar" Grid.Row="3" Margin="16,10,16,0" CornerRadius="10"
                    Background="{DynamicResource BrushBackgroundMid}">
                <Grid Margin="14,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🔍" FontSize="16"
                               VerticalAlignment="Center" Margin="0,0,10,0" Opacity="0.5"/>
                    <Grid Grid.Column="1">
                        <TextBox x:Name="GlobalCitySearchBox"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource BrushTextPrimary}"
                                 FontSize="13" CaretBrush="{DynamicResource BrushAccentCyan}"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Type a city, country or timezone to add it to your list"
                                 AutomationProperties.Name="AddCitySearch"
                                 GotFocus="GlobalCitySearch_GotFocus"
                                 TextChanged="GlobalCitySearch_TextChanged"
                                 KeyDown="GlobalCitySearch_KeyDown"
                                 LostFocus="GlobalCitySearch_LostFocus"/>
                        <TextBlock x:Name="GlobalCitySearchPlaceholder"
                                   Text="Add a city, country or timezone…"
                                   IsHitTestVisible="False" VerticalAlignment="Center"
                                   Opacity="0.4" FontSize="13"
                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- LOCATION CARDS -->
            <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" Margin="8,6,8,0">
                <ItemsControl x:Name="LocationsPanel" ItemsSource="{Binding Locations}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- AllowDrop + drag events enable reordering by dropping onto another card -->
                            <Border Style="{StaticResource CardBorder}" Width="220"
                                    AllowDrop="True"
                                    DragOver="Card_DragOver"
                                    DragLeave="Card_DragLeave"
                                    Drop="Card_Drop">
                                <Border.BorderBrush>
                                    <SolidColorBrush Color="Transparent"/>
                                </Border.BorderBrush>
                                <Grid>
                                    <!-- Accent bar -->
                                    <Border HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                            Width="4" CornerRadius="4" Margin="-20,-16,0,-16"
                                            Background="{Binding AccentBrush}"/>

                                    <!-- ═══ NORMAL VIEW (collapsed while editing) ════════════════════ -->
                                    <StackPanel Margin="8,0,0,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <!-- Header row: drag handle + flag + city name -->
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>  <!-- drag handle -->
                                                <ColumnDefinition Width="*"/>     <!-- flag + city -->
                                            </Grid.ColumnDefinitions>

                                            <!-- Drag handle (⠇) — always visible, hidden for UTC which never appears here -->
                                            <TextBlock Grid.Column="0" Text="⠇" FontSize="15"
                                                       Foreground="{DynamicResource BrushTextDim}"
                                                       VerticalAlignment="Center" Margin="0,0,6,0"
                                                       Cursor="SizeAll" ToolTip="Drag to reorder"
                                                       PreviewMouseLeftButtonDown="DragHandle_MouseDown"/>

                                            <!-- Flag + City name -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding CountryFlag}" FontSize="22"
                                                           VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <TextBlock.Effect>
                                                        <DropShadowEffect Color="White" BlurRadius="24" ShadowDepth="0"
                                                                          Opacity="{DynamicResource GlowOpacitySubtle}"/>
                                                    </TextBlock.Effect>
                                                </TextBlock>
                                                <TextBlock Text="{Binding CityName}" Style="{StaticResource CityLabel}"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Time -->
                                        <TextBlock Text="{Binding CurrentTime}"
                                                   Style="{StaticResource DigitalTime}" FontSize="34"
                                                   Foreground="{Binding AccentBrush}">
                                            <TextBlock.Effect>
                                                <DropShadowEffect BlurRadius="12" ShadowDepth="0"
                                                                  Opacity="{DynamicResource GlowOpacity}" Color="#00BFFF"/>
                                            </TextBlock.Effect>
                                        </TextBlock>
                                        <!-- Date -->
                                        <TextBlock Text="{Binding CurrentDate}"
                                                   FontFamily="Consolas" FontSize="11"
                                                   Foreground="{DynamicResource BrushTextDim}"
                                                   TextAlignment="Center" Margin="0,4,0,0"/>
                                        <Border Height="1" Margin="0,8" Background="{DynamicResource BrushSeparator}"/>
                                        <!-- DST / STD badge + team label + offset -->
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center" Margin="0,0,0,4">
                                            <Border CornerRadius="3" Padding="5,2" Margin="0,0,6,0"
                                                    Background="{DynamicResource BrushBackgroundDark}">
                                                <TextBlock Text="{Binding DstLabel}"
                                                           FontFamily="Consolas" FontSize="9"
                                                           FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource BrushTextDim}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDst}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource BrushDstActive}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <TextBlock Text="{Binding TeamLabel}" Style="{StaticResource SubLabel}"
                                                       FontSize="10" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding UtcOffset}"
                                                   FontFamily="Consolas" FontSize="12"
                                                   TextAlignment="Center" Foreground="{Binding AccentBrush}"/>
                                    </StackPanel>

                                    <!-- ═══ EDIT VIEW (visible while editing) ══════════════════════════ -->
                                    <StackPanel Margin="8,0,0,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <TextBlock Text="✏ EDIT" FontFamily="Consolas" FontSize="9" FontWeight="Bold"
                                                   Foreground="{DynamicResource BrushAccentCyan}" Margin="0,0,0,8"/>

                                        <!-- Flag + City name row -->
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     Text="{Binding EditingCountryFlag, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource CardEditBox}"
                                                     FontSize="16" Padding="4"
                                                     Margin="0,0,4,0" ToolTip="Flag emoji"/>
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding EditingCityName, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource CardEditBox}"
                                                     ToolTip="City display name"/>
                                        </Grid>

                                        <!-- Team label -->
                                        <TextBox Text="{Binding EditingTeamLabel, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource CardEditBox}"
                                                 Margin="0,0,0,8" ToolTip="Team label"/>

                                        <!-- Live time (still ticking while editing) -->
                                        <TextBlock Text="{Binding CurrentTime}"
                                                   FontFamily="Consolas" FontSize="20" FontWeight="Bold"
                                                   TextAlignment="Center" Margin="0,0,0,8"
                                                   Foreground="{Binding AccentBrush}"/>

                                        <!-- Save / Cancel -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="✓" Click="SaveCard_Click" Tag="{Binding}"
                                                    Background="#1B5E20" Foreground="White"
                                                    Width="40" Height="26" FontSize="14"
                                                    BorderThickness="0" Cursor="Hand"
                                                    Margin="0,0,6,0" ToolTip="Save changes">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                CornerRadius="6" Padding="4">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <Button Content="✕" Click="CancelCard_Click" Tag="{Binding}"
                                                    Background="#7F2020" Foreground="White"
                                                    Width="26" Height="26" FontSize="12"
                                                    BorderThickness="0" Cursor="Hand"
                                                    ToolTip="Cancel">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                CornerRadius="6" Padding="4">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Edit button (✏) — top-right, visible only when EditMode is ON -->
                                    <Button Content="✏" FontSize="12"
                                            Width="24" Height="24"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="0,-8,22,0"
                                            Foreground="{DynamicResource BrushAccentCyan}"
                                            BorderThickness="0" Cursor="Hand"
                                            ToolTip="Edit this clock"
                                            Click="EditCard_Click" Tag="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bd" Background="Transparent"
                                                                    CornerRadius="12" Padding="2">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <!-- Show when global EditMode is ON and this card is not already editing -->
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Source={x:Static local:EditModeProxy.Instance}, Path=EditMode}" Value="True"/>
                                                            <Condition Binding="{Binding IsEditing}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- Delete button (✕) — top-right, visible only when DeleteMode is ON -->
                                    <Button Content="✕" FontSize="14"
                                            Width="26" Height="26"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="0,-8,-8,0"
                                            Background="#C62828" Foreground="White" BorderThickness="0"
                                            Cursor="Hand"
                                            AutomationProperties.Name="DeleteCityButton"
                                            Tag="{Binding}" Click="DeleteCard_Click">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    CornerRadius="13" Padding="2">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Source={x:Static local:DeleteModeProxy.Instance}, Path=DeleteMode}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- FOOTER -->
            <!-- SEARCH DROPDOWN OVERLAY
                 Canvas spans all rows at ZIndex 100 inside the same visual tree.
                 This avoids the AllowsTransparency + Popup HWND Z-order bug where
                 the layered window surface renders on top of the Popup's separate HWND. -->
            <Canvas x:Name="SearchOverlayCanvas" Grid.Row="0" Grid.RowSpan="6"
                    Panel.ZIndex="100" IsHitTestVisible="False">
                <Border x:Name="GlobalSearchDropdown"
                        Visibility="Collapsed"
                        IsHitTestVisible="True"
                        Background="{DynamicResource BrushBackgroundMid}"
                        BorderBrush="{DynamicResource BrushAccentCyan}"
                        BorderThickness="1" CornerRadius="0,0,8,8"
                        SnapsToDevicePixels="True">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="14"
                                          ShadowDepth="4" Opacity="0.8"/>
                    </Border.Effect>
                    <ListBox x:Name="GlobalCitySearchList"
                             AutomationProperties.Name="GlobalCitySearchList"
                             MaxHeight="260"
                             Background="{DynamicResource BrushBackgroundMid}"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="GlobalCitySearch_ResultSelected">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding"    Value="12,8"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                                <Setter Property="Background" Value="{DynamicResource BrushBackgroundMid}"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd"
                                                    Background="{TemplateBinding Background}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushBackgroundCard}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushAccentCyan}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding CountryFlag}" FontSize="18"
                                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding City}" FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                                        <TextBlock Text="{Binding Country}" FontSize="10"
                                                   Foreground="{DynamicResource BrushTextDim}"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Canvas>

            <Border Grid.Row="5" Background="{DynamicResource BrushBackgroundMid}" Padding="16,8">
                <TextBlock Text="© 2026 World Clock  •  All times update every second  •  Built with .NET 8 WPF"
                           FontSize="10" Foreground="{DynamicResource BrushTextDim}"
                           HorizontalAlignment="Center"/>
            </Border>
        </Grid>
    </Border>

            </Grid>
        </Viewbox>
    </ScrollViewer>
</Window>

<Window x:Class="WorldClock.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WorldClock — Diagnostics"
        Width="640" Height="140"
        MinWidth="400" MinHeight="80"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="CanResize"
        WindowStartupLocation="Manual">

    <Border Background="#E5000000"
            BorderBrush="#44FFFF00"
            BorderThickness="1"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="22"/>   <!-- drag handle / title bar -->
                <RowDefinition Height="*"/>    <!-- content -->
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" Background="#33FFFF00">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="⚙ DIAGNOSTICS"
                           FontFamily="Consolas" FontSize="10" FontWeight="Bold"
                           Foreground="#FFFF00"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"/>
                <Button Grid.Column="1"
                        Content="✕"
                        Width="28" Height="22"
                        BorderThickness="0"
                        Background="Transparent"
                        Foreground="#FFFF00"
                        FontSize="11"
                        Cursor="Hand"
                        Click="CloseButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="Transparent">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#C00C0C"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="#FFFF00"/>
                            <Setter Property="Cursor"     Value="Hand"/>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- Diagnostics content -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="8,4">
                <TextBlock Text="{Binding Translator.DiagStatus}"
                           FontFamily="Consolas" FontSize="9"
                           Foreground="#FFFF00"
                           TextWrapping="Wrap"/>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
